# The kiosk session: sway on tty7 as the desktop user, in a logind session on seat0,
# in place of a display manager and an X server. install.sh fills in @USER@ and @HOME@
# and installs this as /etc/systemd/system/hermes-beaver-kiosk.service.
[Unit]
Description=hermes-beaver kiosk (sway on tty7)
Documentation=https://github.com/ideaconnect/hermes-beaver
After=systemd-user-sessions.service plymouth-quit-wait.service getty@tty7.service
Wants=dbus.socket systemd-logind.service
After=dbus.socket systemd-logind.service
Conflicts=getty@tty7.service
ConditionPathExists=/dev/tty0

[Service]
User=@USER@
WorkingDirectory=~
# A logind session (pam_systemd), so sway may open the GPU and the input devices.
PAMName=hermes-beaver-kiosk
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_DESKTOP=sway XDG_CURRENT_DESKTOP=sway
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty7
UtmpMode=user
ExecStart=/usr/bin/sway --config @HOME@/.config/hermes-beaver/sway.conf
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
Alias=display-manager.service
