[Unit]
Description=hermes-beaver dashboard for Hermes Agent
Documentation=https://github.com/ideaconnect/hermes-beaver
# Started by the kiosk's sway (see sway.conf), which first imports WAYLAND_DISPLAY
# into the user manager.

[Service]
ExecStart=%h/.local/bin/hermes-beaver
# Always: on the kiosk there's nothing else on screen, so quitting (q, Esc) restarts it too.
Restart=always
RestartSec=5
# SIGTERM ends the event loop cleanly so the monitor brightness is restored.
KillSignal=SIGTERM
TimeoutStopSec=15
