import { Theme, Tone } from "theme.slint";
import { Panel, SubHeading, TaskRow, NeedRow, DoneRow, MetricRow, Hint, TaskItem, NeedItem, DoneItem, MetricItem } from "widgets.slint";

export { TaskItem, NeedItem, DoneItem, MetricItem }

// The main (and in v1 only) screen: 2x2 grid, left column 60%.
component MainScreen inherits VerticalLayout {
    in property <string> hostname;
    in property <string> clock;
    in property <string> seconds;
    in property <string> banner;
    in property <[TaskItem]> tasks;
    in property <string> tasks-hint;
    in property <[NeedItem]> needs;
    in property <string> needs-hint;
    in property <[DoneItem]> done;
    in property <string> done-hint;
    in property <[MetricItem]> metrics;
    in property <string> beaver-art;
    in property <string> beaver-caption;
    in property <int> beaver-tone;
    in property <string> counter;
    in property <string> counter-label;

    padding: Theme.gap;
    spacing: Theme.gap;

    // Header: hostname · health banner · clock
    HorizontalLayout {
        height: 52px;
        spacing: Theme.gap;
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.hostname;
            color: Theme.accent;
            font-size: Theme.font-header;
            font-weight: 800;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            background: root.banner == "" ? transparent : Theme.danger;
            border-radius: 8px;
            Text {
                width: parent.width - 32px;
                text: root.banner;
                color: white;
                font-size: Theme.font-body;
                font-weight: 700;
                horizontal-alignment: center;
                overflow: elide;
            }
        }

        HorizontalLayout {
            Text {
                text: root.clock;
                color: Theme.text;
                font-size: Theme.font-header;
                font-weight: 700;
                vertical-alignment: center;
            }

            // Ticks every second: if the seconds stop, the dashboard is frozen.
            Text {
                text: root.seconds;
                color: Theme.text-dim;
                font-size: Theme.font-header;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }

    // Fixed 2x2 geometry (not a layout) so panel content never shifts the grid.
    grid := Rectangle {
        vertical-stretch: 1;
        property <length> left-w: (self.width - Theme.gap) * 0.6;
        property <length> right-w: self.width - self.left-w - Theme.gap;
        property <length> row-h: (self.height - Theme.gap) / 2;

        Panel {
            x: 0;
            y: 0;
            width: grid.left-w;
            height: grid.row-h;
            title: "TASKS & QUEUE";
            VerticalLayout {
                spacing: 12px;
                for item in root.tasks: TaskRow {
                    item: item;
                }
                if root.tasks-hint != "": Hint {
                    text: root.tasks-hint;
                }
            }
        }

        Panel {
            x: 0;
            y: grid.row-h + Theme.gap;
            width: grid.left-w;
            height: grid.row-h;
            title: "NEEDS YOU";
            VerticalLayout {
                spacing: 10px;
                for item in root.needs: NeedRow {
                    item: item;
                }
                if root.needs-hint != "": Hint {
                    text: root.needs-hint;
                }
                Rectangle {
                    height: 6px;
                }

                SubHeading {
                    text: "RECENTLY FINISHED";
                }

                for item in root.done: DoneRow {
                    item: item;
                }
                if root.done-hint != "": Hint {
                    text: root.done-hint;
                }
            }
        }

        Panel {
            x: grid.left-w + Theme.gap;
            y: 0;
            width: grid.right-w;
            height: grid.row-h;
            title: "SYSTEM LOAD";
            VerticalLayout {
                spacing: 16px;
                for item in root.metrics: MetricRow {
                    visible: item.shown;
                    item: item;
                }
            }
        }

        Panel {
            x: grid.left-w + Theme.gap;
            y: grid.row-h + Theme.gap;
            width: grid.right-w;
            height: grid.row-h;
            title: "BEAVER";
            HorizontalLayout {
                spacing: 24px;
                Text {
                    text: root.beaver-art;
                    font-family: Theme.mono;
                    font-size: Theme.font-mono;
                    color: Tone.color(root.beaver-tone);
                    wrap: no-wrap;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 6px;
                    Text {
                        text: root.beaver-caption;
                        color: Tone.color(root.beaver-tone);
                        font-size: Theme.font-body;
                        font-weight: 700;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        height: 18px;
                    }

                    Text {
                        text: root.counter;
                        color: Theme.text;
                        font-size: 76px;
                        font-weight: 800;
                    }

                    Text {
                        text: root.counter-label;
                        color: Theme.text-dim;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    in property <string> hostname: "hermes";
    in property <string> clock: "--:--";
    in property <string> seconds;
    in property <string> banner: "";
    in property <[TaskItem]> tasks;
    in property <string> tasks-hint;
    in property <[NeedItem]> needs;
    in property <string> needs-hint;
    in property <[DoneItem]> done;
    in property <string> done-hint;
    in property <[MetricItem]> metrics;
    in property <string> beaver-art;
    in property <string> beaver-caption;
    in property <int> beaver-tone;
    in property <string> counter: "0";
    in property <string> counter-label;
    callback quit();
    callback toggle-fullscreen();

    title: "hermes-beaver";
    preferred-width: 1920px;
    preferred-height: 1080px;
    background: Theme.bg;
    default-font-size: Theme.font-body;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape || event.text == "q") {
                root.quit();
                return accept;
            }
            if (event.text == Key.F11) {
                root.toggle-fullscreen();
                return accept;
            }
            reject
        }

        MainScreen {
            hostname: root.hostname;
            clock: root.clock;
            seconds: root.seconds;
            banner: root.banner;
            tasks: root.tasks;
            tasks-hint: root.tasks-hint;
            needs: root.needs;
            needs-hint: root.needs-hint;
            done: root.done;
            done-hint: root.done-hint;
            metrics: root.metrics;
            beaver-art: root.beaver-art;
            beaver-caption: root.beaver-caption;
            beaver-tone: root.beaver-tone;
            counter: root.counter;
            counter-label: root.counter-label;
        }

        // Display-only dashboard: hide the pointer everywhere.
        TouchArea {
            mouse-cursor: none;
        }
    }
}
